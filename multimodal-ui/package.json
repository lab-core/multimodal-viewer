{
  "name": "multimodal-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run set-env && ng serve --poll 1000",
    "build": "npm run set-env && ng build",
    "set-env": "ts-node scripts/set-environment.ts && prettier --write ./angular.json ./public/environment.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --poll 1000",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.6",
    "@angular/cdk": "^20.2.9",
    "@angular/common": "^20.3.6",
    "@angular/compiler": "^20.3.6",
    "@angular/core": "^20.3.6",
    "@angular/forms": "^20.3.6",
    "@angular/material": "^20.2.9",
    "@angular/platform-browser": "^20.3.6",
    "@angular/platform-browser-dynamic": "^20.3.6",
    "@angular/router": "^20.3.6",
    "@bluehalo/ngx-leaflet": "^20.0.0",
    "@googlemaps/polyline-codec": "^1.0.28",
    "@types/stats.js": "^0.17.3",
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "dotenv": "^16.5.0",
    "hotkeys-js": "^3.13.9",
    "jimp": "^1.6.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-pixi-overlay": "^1.9.4",
    "ngx-socket-io": "^4.9.3",
    "node-random-name": "^1.0.1",
    "pixi-filters": "^5.3.0",
    "pixi.js": "^7.4.2",
    "prettier": "^3.4.2",
    "prettier-eslint": "^16.3.0",
    "rxjs": "~7.8.0",
    "stats.js": "^0.17.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.6",
    "@angular/cli": "^20.3.6",
    "@angular/compiler-cli": "^20.3.6",
    "@types/d3-color": "^3.1.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.14.1",
    "@types/node-random-name": "^1.0.2",
    "angular-eslint": "20.4.0",
    "eslint": "^9.28.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.33.1"
  },
  "engines": {
    "node": "=22.20.0",
    "npm": "=10.9.2"
  }
}
